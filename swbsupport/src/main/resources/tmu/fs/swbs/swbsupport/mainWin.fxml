<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="350.0" maxWidth="-Infinity" minHeight="350.0" minWidth="-Infinity" prefHeight="350.0" prefWidth="600.0" style="-fx-background-color: #fffff0;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tmu.fs.swbs.swbsupport.MainWinController">
    <children>
        <BorderPane layoutX="26.0" layoutY="27.0" maxHeight="320.0" prefHeight="300.0" prefWidth="551.0">
            <top>
                <VBox alignment="CENTER" nodeOrientation="RIGHT_TO_LEFT" prefWidth="100.0" BorderPane.alignment="CENTER">
                    <children>
                        <FlowPane prefWrapLength="0.0">
                            <children>
                                <Label fx:id="versionDisplay" alignment="CENTER_RIGHT" contentDisplay="RIGHT" depthTest="ENABLE" nodeOrientation="LEFT_TO_RIGHT" text="*****">
                                    <font>
                                        <Font size="10.0" />
                                    </font>
                                    <opaqueInsets>
                                        <Insets />
                                    </opaqueInsets>
                                </Label>
                            </children>
                        </FlowPane>
                        <Label text="STAMP Workbench 応援団">
                            <font>
                                <Font size="24.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>
            </top>
            <center>
                <VBox prefHeight="295.0" prefWidth="551.0" BorderPane.alignment="CENTER">
                    <children>
                        <HBox prefHeight="100.0" prefWidth="200.0">
                            <children>
                                <Label alignment="CENTER" text="STAMPプロジェクトファイル">
                                    <HBox.margin>
                                        <Insets left="30.0" top="22.0" />
                                    </HBox.margin>
                                </Label>
                                <TextField fx:id="stampPrijectDirFile" maxWidth="-Infinity" minWidth="300.0">
                                    <opaqueInsets>
                                        <Insets />
                                    </opaqueInsets>
                                    <HBox.margin>
                                        <Insets left="30.0" right="20.0" top="20.0" />
                                    </HBox.margin>
                                </TextField>
                                <Button mnemonicParsing="false" onAction="#fileSelectionAction" text="参照">
                                    <HBox.margin>
                                        <Insets top="20.0" />
                                    </HBox.margin>
                                </Button>
                            </children>
                            <VBox.margin>
                                <Insets top="30.0" />
                            </VBox.margin>
                        </HBox>
                        <HBox prefHeight="100.0" prefWidth="200.0">
                            <children>
                                <Label text="出力形式">
                                    <HBox.margin>
                                        <Insets left="70.0" right="30.0" />
                                    </HBox.margin>
                                </Label>
                                <VBox prefHeight="200.0" prefWidth="100.0">
                                    <children>
                                        <RadioButton fx:id="excelSelection" mnemonicParsing="false" text="Excel形式">
                                            <VBox.margin>
                                                <Insets bottom="5.0" />
                                            </VBox.margin>
                                        </RadioButton>
                                        <RadioButton fx:id="markdownSelection" mnemonicParsing="false" text="マークダウン形式">
                                            <opaqueInsets>
                                                <Insets />
                                            </opaqueInsets>
                                            <VBox.margin>
                                                <Insets bottom="5.0" />
                                            </VBox.margin>
                                        </RadioButton>
                                        <RadioButton fx:id="csvSelection" mnemonicParsing="false" text="CSV形式">
                                            <VBox.margin>
                                                <Insets bottom="5.0" />
                                            </VBox.margin>
                                        </RadioButton>
                                        <RadioButton fx:id="tabTextSelection" mnemonicParsing="false" text="タブテキスト" />
                                    </children>
                                </VBox>
                                <Label text="出力ソート順序">
                                    <padding>
                                        <Insets left="70.0" right="30.0" />
                                    </padding>
                                </Label>
                                <VBox prefHeight="200.0" prefWidth="100.0">
                                    <children>
                                        <RadioButton fx:id="ucaOrderSelection" mnemonicParsing="false" text="UCA番号順">
                                            <VBox.margin>
                                                <Insets bottom="5.0" />
                                            </VBox.margin>
                                        </RadioButton>
                                        <RadioButton fx:id="coordinateOrderSelection" mnemonicParsing="false" text="表示座標順" />
                                    </children>
                                </VBox>
                            </children>
                            <VBox.margin>
                                <Insets bottom="30.0" top="30.0" />
                            </VBox.margin>
                        </HBox>
                    </children>
                </VBox>
            </center>
            <bottom>
                <FlowPane prefHeight="50.0" prefWidth="200.0" BorderPane.alignment="CENTER">
                    <children>
                        <Button alignment="CENTER_RIGHT" contentDisplay="RIGHT" mnemonicParsing="false" onAction="#executeAction" text="実行">
                            <FlowPane.margin>
                                <Insets left="350.0" right="10.0" />
                            </FlowPane.margin>
                        </Button>
                        <Button contentDisplay="RIGHT" mnemonicParsing="false" onAction="#clearAction" text="クリア">
                     <FlowPane.margin>
                        <Insets right="10.0" />
                     </FlowPane.margin></Button>
                  <Button mnemonicParsing="false" onAction="#aboutAction" text="about" />
                    </children>
                </FlowPane>
            </bottom>

        </BorderPane>
    </children>
</AnchorPane>
